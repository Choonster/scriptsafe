    "@crxjs/vite-plugin": "^2.3.0",
    "@types/chrome": "^0.1.4",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.4",
    "@types/pako": "^2.0.4",
    "prettier": "^3.6.2",
    "sass": "^1.97.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "web-ext": "^10.5.0"
